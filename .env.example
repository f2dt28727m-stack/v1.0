# QuizFig environment variables.
# Copy to `.env` for local dev (loaded by Vercel CLI / `vercel dev`).
# For production, set these in the Vercel dashboard → Project Settings → Environment Variables.

# ---------- Public site config ----------
# Origin used for canonical / og:url / sitemap links. NO trailing slash.
SITE_URL=https://quizfig.com

# ---------- Cloudflare Turnstile (anti-bot on /api/token) ----------
# 1) Site key is PUBLIC and goes in the HTML (quiz.html). It is currently a
#    placeholder — replace it with your real key to enable the widget.
# 2) Secret key is PRIVATE and is verified by api/index.py. If you do NOT set
#    TURNSTILE_SECRET, the server allows all /api/token requests (rate limit is
#    still active). To enable protection, set both keys.
# Get keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=

# ---------- Upstash Redis (optional, for global rate limiting) ----------
# Default rate limit is in-memory per serverless instance — fine for light
# traffic but NOT shared across Vercel regions. For accurate global limits,
# create a free Upstash Redis database (https://upstash.com) and set both:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Rate limit thresholds (req / window-seconds) ----------
# Optional overrides. Comment in to tune. Defaults are:
#   /api/token     10 / 60
#   /api/questions 30 / 60
#   /api/result    30 / 60
#   read endpoints 120 / 60
#   global         240 / 60
# RL_TOKEN=15
# RL_QUESTIONS=60
# RL_RESULT=60
# RL_READ=240
# RL_GLOBAL=480
