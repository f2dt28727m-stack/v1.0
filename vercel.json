{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "includeFiles": [
          "quizzes/**",
          "data/**",
          "config.json"
        ]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "quiz.html",
      "use": "@vercel/static"
    },
    {
      "src": "quizzes/",
      "use": "@vercel/static"
    },
    {
      "src": "css/",
      "use": "@vercel/static"
    },
    {
      "src": "js/",
      "use": "@vercel/static"
    },
    {
      "src": "data/",
      "use": "@vercel/static"
    },
    {
      "src": "onequiz.json",
      "use": "@vercel/static"
    },
    {
      "src": "config.json",
      "use": "@vercel/static"
    },
    {
      "src": "quizzes.json",
      "use": "@vercel/static"
    },
    {
      "src": "og-default.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/quiz-detail.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(.+)"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "/quiz/$1"
      }
    },
    {
      "src": "/quiz-detail.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/quiz/(.+)",
      "dest": "/api/index.py"
    },
    {
      "src": "/mbti-types",
      "dest": "/api/index.py"
    },
    {
      "src": "/mbti-types/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/characters",
      "dest": "/api/index.py"
    },
    {
      "src": "/characters/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/llms-full.txt",
      "dest": "/api/index.py"
    },
    {
      "src": "/llms.txt",
      "dest": "/api/index.py"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/index.py"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
